# Use an allowlist so Docker never receives Git history, local databases,
# dependencies, logs, tests, backups, or other development-only files.
**

!package.json
!package-lock.json

!src/
!src/**

!scripts/
!scripts/**

!updates/
!updates/**

!CHANGELOG.md

# Runtime media is bind-mounted from the Oracle project directory. Keeping it
# out of the build context prevents every Docker build from uploading all
# assets, even when only source code changes.

!activity/
!activity/public/
!activity/public/**
